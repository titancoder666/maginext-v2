---
import Base from '../layouts/Base.astro';
import { ADVISORS } from '../data/site.js';
---
<Base title="顾问团队 · Maginex" description="前 UC Berkeley 招生官、前 USCIS 签证官、藤校文书导师 — 实名团队，LinkedIn 可查。">
  <section class="hero">
    <div class="container" style="text-align:center;max-width:900px">
      <div class="eyebrow">TEAM · 顾问团队</div>
      <h1 class="hero-title">坐过录取桌<br/><span class="hl">另一端</span>的人。</h1>
      <p class="hero-lede">不是"金牌顾问培训班"，不是培训出来的销售。我们的核心顾问全部来自美国大学招生办公室、USCIS、知名律所 — LinkedIn 可查，签约前可视频面谈。</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      <div class="adv-list">
        {ADVISORS.map(a => (
          <article id={a.slug} class="adv-row card">
            <div class="adv-photo-big" style={`background:${a.bgColor}`}>{a.photo}</div>
            <div style="flex:1">
              <div style="display:flex;gap:10px;align-items:center;margin-bottom:8px">
                <span style="font-size:11px;color:var(--c-green);font-weight:600;letter-spacing:1px">● 实名顾问</span>
                <span style="font-size:11px;color:#999">LinkedIn 可查</span>
              </div>
              <h2 style="font-size:36px;font-weight:700;letter-spacing:-1px">{a.cn} <span style="color:#999;font-weight:400;font-size:24px;font-family:Georgia,serif">{a.en}</span></h2>
              <div style="font-size:16px;color:var(--c-muted);margin-top:8px">{a.role}</div>
              <p style="font-size:15px;line-height:1.7;margin-top:20px;color:#333">{a.bio}</p>
              <div style="display:flex;gap:6px;flex-wrap:wrap;margin-top:18px">
                {a.tags.map(t => <span class="adv-tag">{t}</span>)}
              </div>
              <div style="display:flex;gap:10px;margin-top:24px;flex-wrap:wrap">
                <a class="btn btn-ghost">查看 LinkedIn ↗</a>
                <a href="/contact/" class="btn btn-primary">预约 1v1 →</a>
              </div>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>

<style>
.hero { padding: 88px 0 56px; }
.hero-title { font-size: 72px; font-weight: 700; letter-spacing: -2.5px; line-height: 1.05; margin-top: 18px; }
.hero-lede { font-size: 18px; line-height: 1.7; color: #444; margin-top: 28px; }

.adv-list { display: flex; flex-direction: column; gap: 32px; }
.adv-row { display: flex; gap: 40px; padding: 40px; align-items: flex-start; }
.adv-photo-big { width: 200px; height: 240px; border-radius: 16px; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 80px; font-weight: 600; font-family: Georgia, serif; flex-shrink: 0; }
.adv-tag { padding: 4px 10px; background: var(--c-soft); border-radius: 99px; font-size: 11px; color: var(--c-muted); }

@media (max-width: 768px) {
  .hero-title { font-size: 40px; letter-spacing: -1.5px; }
  .adv-row { flex-direction: column; padding: 24px; gap: 20px; }
  .adv-photo-big { width: 100%; height: 200px; }
  .adv-row h2 { font-size: 26px !important; }
}
</style>
</Base>
