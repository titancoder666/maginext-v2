---
import Base from '../layouts/Base.astro';
import EmergencyGrid from '../components/EmergencyGrid.astro';
import ProcessSteps from '../components/ProcessSteps.astro';
import OfferWall from '../components/OfferWall.astro';
import { SITE, GUARANTEES, STATS, ADVISORS, CASES, SERVICES, FAQ, PARTNERS } from '../data/site.js';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": FAQ.map(f => ({
    "@type": "Question",
    "name": f.q,
    "acceptedAnswer": { "@type": "Answer", "text": f.a },
  })),
};

const orgJsonLd = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "name": "Maginex Education",
  "url": SITE.url,
  "description": SITE.description,
  "email": SITE.email,
  "telephone": SITE.phone,
  "sameAs": [],
};
---
<Base>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqJsonLd)}></script>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(orgJsonLd)}></script>
  <!-- Hero — 5-slide carousel for different incoming intents -->
  <section class="hero">
    <div class="hero-inner">

      <div class="hero-slides" id="hero-slides" aria-live="polite" aria-roledescription="carousel">

        <div class="hero-slide active" data-slide="0">
          <div class="hero-tag"><span class="hero-tag-dot hero-tag-dot-urgent"></span>持牌移民律师 + 前 USCIS 政策顾问 · 24h 待命</div>
          <h1 class="hero-title">身份危机？<br/>24 小时内<br/><span class="hl">有人接你电话</span>。</h1>
          <p class="hero-lede">Reinstatement · 紧急转学 · OPT/H-1B RFE · 学术 dismissal 申诉 · B 转 F 身份转换<br/>每一项都对应具体的法律条文 + 时间窗口。Maginex 团队处理过 400+ 起留学生急救 case。</p>
        </div>

        <div class="hero-slide" data-slide="1" aria-hidden="true">
          <div class="hero-tag"><span class="hero-tag-dot hero-tag-dot-urgent"></span>凌晨 3 点也响应 · 当晚出申诉路径</div>
          <h1 class="hero-title">收到 dismissal letter？<br/>还有 15 天<br/><span class="hl">翻盘窗口</span>。</h1>
          <p class="hero-lede">Probation / Suspension / Dismissal · 5 段式申诉信模板 + procedural error + new evidence + disproportionate sanction 三轨叠加论证<br/>FERPA 引用 + Goss v. Lopez 1975 due process 框架。叠加论证统计成功率 65–75%。</p>
        </div>

        <div class="hero-slide" data-slide="2" aria-hidden="true">
          <div class="hero-tag"><span class="hero-tag-dot hero-tag-dot-purple"></span>保 F-1 不断档 · 48h transfer-in 启动</div>
          <h1 class="hero-title">原校念不下去？<br/>走 CC，<br/><span class="hl">一样能进 UC</span>。</h1>
          <p class="hero-lede">UC 系统 92% transfer 录取来自 CC（2024 年 26,250 人）· IGETC + TAG 路径 · Foothill / De Anza 等强校直推<br/>我们带过 17 个 CC 学生进 Top 6 UC，其中 5 人原校 GPA 低于 2.5。</p>
        </div>

        <div class="hero-slide" data-slide="3" aria-hidden="true">
          <div class="hero-tag"><span class="hero-tag-dot hero-tag-dot-purple"></span>USCIS 内部审查口径 · 84% 通过率</div>
          <h1 class="hero-title">收到 RFE notice？<br/>87 天倒计时<br/><span class="hl">已经开始</span>。</h1>
          <p class="hero-lede">Type A 文件 / Type B 资格 / Type C 意图 三类 RFE · USCIS Policy Manual 标准 5 段式 response 结构<br/>F-1 / OPT 类 RFE 通过率 91% · H-1B 73% · 持牌律师 sign-off。</p>
        </div>

        <div class="hero-slide" data-slide="4" aria-hidden="true">
          <div class="hero-tag"><span class="hero-tag-dot hero-tag-dot-blue"></span>12,000 份审稿样本 · NACAC 标准</div>
          <h1 class="hero-title">高三才决定出国？<br/>4 个月<br/><span class="hl">冲 Top 30</span>。</h1>
          <p class="hero-lede">EA + RD + UC 三轨平行 · 选校 = 2 冲刺 + 4 匹配 + 3 保底 · 文书 4 周写完 6 篇<br/>2025 年我们带的 6 个「高三决定派」里 4 人进 Top 30。Common App + UC App 双系统。</p>
        </div>

      </div>

      <div class="hero-dots" role="tablist" aria-label="选择场景">
        <button type="button" class="hero-dot active" data-idx="0" role="tab" aria-label="身份危机"><span class="hero-dot-bar"></span></button>
        <button type="button" class="hero-dot" data-idx="1" role="tab" aria-label="学术 dismissal 申诉"><span class="hero-dot-bar"></span></button>
        <button type="button" class="hero-dot" data-idx="2" role="tab" aria-label="低 GPA 紧急转学"><span class="hero-dot-bar"></span></button>
        <button type="button" class="hero-dot" data-idx="3" role="tab" aria-label="OPT 或 H-1B RFE"><span class="hero-dot-bar"></span></button>
        <button type="button" class="hero-dot" data-idx="4" role="tab" aria-label="美本申请"><span class="hero-dot-bar"></span></button>
      </div>

      <div class="hero-ctas">
        <button type="button" class="btn btn-primary btn-lg" data-wechat-cta="hero-primary"><span style="color:var(--c-wechat); margin-right:8px">●</span>立即微信咨询 <span style="margin-left:8px">→</span></button>
        <a href="#emergency" class="btn btn-ghost btn-lg">先看 6 类急救场景</a>
      </div>
      <div class="hero-micro">
        {['24h 真人回复','公对公转账','合同律所公证','案件失败退服务费'].map(t => (
          <div class="hero-micro-item"><span class="hero-micro-icon">✓</span>{t}</div>
        ))}
      </div>
      <div class="big-num-row">
        {STATS.map(s => (
          <div class="big-num-cell">
            <div class="big-num">{s.num}{s.unit && <span class="big-num-unit">{s.unit}</span>}</div>
            <div class="big-num-label">{s.label}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <script is:inline>
    (function () {
      const wrap = document.getElementById('hero-slides');
      if (!wrap) return;
      const slides = Array.from(wrap.querySelectorAll('.hero-slide'));
      const dots = Array.from(document.querySelectorAll('.hero-dot'));
      const ROTATE_MS = 2000;
      let cur = 0, timer = null;
      const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

      function show(i) {
        slides.forEach((s, j) => {
          s.classList.toggle('active', j === i);
          s.setAttribute('aria-hidden', j === i ? 'false' : 'true');
        });
        dots.forEach((d, j) => d.classList.toggle('active', j === i));
        cur = i;
      }
      function next() { show((cur + 1) % slides.length); }
      function start() {
        if (reduced) return;
        stop();
        timer = setInterval(next, ROTATE_MS);
      }
      function stop() { if (timer) { clearInterval(timer); timer = null; } }

      dots.forEach((d, i) => d.addEventListener('click', () => { show(i); start(); }));
      wrap.addEventListener('mouseenter', stop);
      wrap.addEventListener('mouseleave', start);

      // Pause when tab not visible
      document.addEventListener('visibilitychange', () => document.hidden ? stop() : start());

      start();
    })();
  </script>

  <EmergencyGrid />
  <ProcessSteps />

  <!-- Promises -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">POLICY · 我们的承诺</div>
        <h2 class="h2">比"满意度 100%"<br/>更<span class="hl">具体</span>的承诺。</h2>
        <p class="sub">虚的话谁都会说。我们写在合同里、过律师所公证。</p>
      </div>
      <div class="grid-4">
        {GUARANTEES.map(g => (
          <div class="card">
            <div class="promise-icon">{g.icon}</div>
            <div class="promise-title">{g.title}</div>
            <div class="promise-desc">{g.desc}</div>
            <div class="promise-link">查看条款 →</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Advisors / Team -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">TEAM · 团队结构</div>
        <h2 class="h2">持牌律师 + 学术规划师 +<br/><span class="hl">USCIS 政策研究组</span>。</h2>
        <p class="sub">急救场景由持牌移民律师主导（AILA 会员）；学术与申请规划由前美国大学招生 / 文书顾问组负责。下图为团队职能展示，签约后会列明你 case 的具体对接成员。</p>
      </div>
      <div class="grid-4">
        {ADVISORS.map(a => (
          <a href={`/consultants/#${a.slug}`} class="card card-white advisor-card">
            <div class="adv-photo">
              <div class="adv-avatar" style={`background:${a.bgColor}`}>{a.photo}</div>
              <div class="adv-badge"><span style="color:var(--c-green)">●</span> 实名</div>
            </div>
            <div class="adv-name">{a.cn}</div>
            <div class="adv-role">{a.role}</div>
            <div class="adv-tags">{a.tags.map(t => <span class="adv-tag">{t}</span>)}</div>
            <div class="adv-foot">
              <span class="adv-foot-link">LinkedIn ↗</span>
              <span class="adv-foot-link">预约 →</span>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Bento — results -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">RESULTS · 录取数据</div>
        <h2 class="h2">517 封 offer，<br/><span class="hl">下面是其中一部分</span>。</h2>
      </div>
      <div class="bento">
        <div class="bento-cell bento-feature">
          <div class="bento-eyebrow">FEATURED · 2025</div>
          <div class="bento-num-big">12 封<br/>UC 录取</div>
          <div class="bento-sub" style="margin-top:14px">Berkeley · UCLA · UCSD · UCSB · UCI<br/>单届最高 UC 录取数</div>
          <div class="chip-row" style="margin-top:auto;padding-top:24px">
            {['UCB','UCLA','UCSD','UCI','UCSB','UCD'].map(s => <span class="chip">{s}</span>)}
          </div>
        </div>
        <div class="bento-cell">
          <div class="bento-eyebrow">IVY</div>
          <div class="bento-num">23</div>
          <div class="bento-sub">藤校录取</div>
          <div class="chip-row">{['Harvard','Yale','Princeton','Penn','Columbia','Cornell'].map(s => <span class="chip">{s}</span>)}</div>
        </div>
        <div class="bento-cell bento-dark">
          <div class="bento-eyebrow" style="color:var(--c-accent)">TOP 30</div>
          <div class="bento-num">43%</div>
          <div class="bento-sub" style="color:rgba(255,255,255,.7)">录取率 (近 3 年)</div>
          <div style="font-size:12px;color:rgba(255,255,255,.5);margin-top:14px;line-height:1.6">行业平均 18% · 来源：US News</div>
        </div>
        <div class="bento-cell">
          <div class="bento-eyebrow">STEM</div>
          <div class="bento-num">189</div>
          <div class="bento-sub">CS / 工程录取</div>
          <div class="chip-row">{['MIT','CMU','Stanford','GaTech','UIUC'].map(s => <span class="chip">{s}</span>)}</div>
        </div>
        <div class="bento-cell">
          <div class="bento-eyebrow">BUSINESS</div>
          <div class="bento-num">67</div>
          <div class="bento-sub">商科录取</div>
          <div class="chip-row">{['NYU Stern','Wharton','Ross','Marshall'].map(s => <span class="chip">{s}</span>)}</div>
        </div>
        <div class="bento-cell">
          <div class="bento-eyebrow">TRANSFER</div>
          <div class="bento-num">72</div>
          <div class="bento-sub">美本转学成功</div>
          <div style="font-size:12px;color:var(--c-muted);margin-top:14px;line-height:1.6">CC → UC<br/>校际转学</div>
        </div>
      </div>
    </div>
  </section>

  <!-- Offer Wall — 43 张录取通知书墙 -->
  <OfferWall />

  <!-- Cases -->
  <section class="section section-soft">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">STORIES · 学生说</div>
        <h2 class="h2">真实学生，<br/><span class="hl">真实数据</span>。</h2>
        <p class="sub">所有案例经学生书面授权 · GPA / 标化成绩可在签约前核验复印件</p>
      </div>
      <div class="grid-3">
        {CASES.slice(0,6).map(c => (
          <article class="card card-white case-card">
            <div class="case-head">
              <div class="case-avatar" style={`background:${c.bg}`}>{c.initials}</div>
              <div style="flex:1">
                <div class="case-name">{c.surname}</div>
                <div class="case-from">{c.from} · '{c.year.slice(2)}</div>
              </div>
              <span class="case-verify">✓ 已核实</span>
            </div>
            <div class="case-school">
              <div class="case-school-name">{c.school}</div>
              <div class="case-major">{c.major}</div>
            </div>
            <div class="case-quote">"{c.quote}"</div>
            <div class="case-stats">
              <div><div class="case-stat-num">{c.gpa}</div><div class="case-stat-key">GPA</div></div>
              {c.sat && <div><div class="case-stat-num">{c.sat}</div><div class="case-stat-key">SAT</div></div>}
            </div>
          </article>
        ))}
      </div>
      <div style="text-align:center;margin-top:48px">
        <a href="/cases/" class="btn btn-ghost btn-lg">查看全部案例 →</a>
      </div>
    </div>
  </section>

  <!-- Services -->
  <section class="section">
    <div class="container">
      <div class="section-head">
        <div class="eyebrow">SERVICES · 服务项目</div>
        <h2 class="h2">从美高到博士，<br/><span class="hl">全周期</span>。</h2>
      </div>
      <div class="grid-3">
        {SERVICES.map((s, i) => (
          <a href={`/services/#${s.id}`} class="card service-card">
            <div class="service-num">0{i+1}</div>
            <div class="service-title">{s.title}</div>
            <div class="service-sub">{s.sub}</div>
            <div class="service-from">建议：{s.from}</div>
            <div class="service-arrow">了解 →</div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section-soft" id="faq">
    <div class="container" style="max-width:880px">
      <div class="section-head">
        <div class="eyebrow">FAQ · 常被问到</div>
        <h2 class="h2">直球<span class="hl">提问，直球回答</span>。</h2>
      </div>
      <div class="grid-2">
        {FAQ.map(f => (
          <div class="card card-white">
            <div class="faq-q">{f.q}</div>
            <div class="faq-a">{f.a}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Partners -->
  <section style="padding:56px 0;border-bottom:1px solid var(--c-border)">
    <div class="container">
      <div style="text-align:center;font-size:11px;letter-spacing:3px;color:var(--c-faint);margin-bottom:24px">合作 / 认证机构</div>
      <div class="partner-strip">
        {PARTNERS.map(p => <div class="partner-logo">{p}</div>)}
      </div>
    </div>
  </section>

  <!-- Final CTA -->
  <section class="final-cta section-dark">
    <div class="container">
      <div class="final-grid">
        <div>
          <div class="eyebrow" style="color:rgba(255,255,255,.5)">FREE ASSESSMENT · 免费评估</div>
          <h2 class="h2-huge">30 分钟。<br/>真人顾问。<br/><span class="hl">0 销售。</span></h2>
          <p style="font-size:17px;color:rgba(255,255,255,.7);line-height:1.7;margin-top:24px;max-width:480px">填完下面的表单，由我们的真实顾问 — 不是销售 — 在 24 小时内回复你。我们不会群发短信，不会催签约，不会卖你信息。</p>
          <div style="display:flex;gap:14px;margin-top:32px;flex-wrap:wrap">
            <button type="button" class="final-chip" data-wechat-cta="final-cta-chip" style="border:1px solid rgba(255,255,255,.18);cursor:pointer;font-family:inherit"><span style="color:var(--c-wechat)">●</span> 扫码加微信 {SITE.wechat}</button>
            <a href={`https://wa.me/${SITE.whatsapp.replace(/[^\d]/g,'')}`} target="_blank" rel="noopener" class="final-chip"><span style="color:#25d366">●</span> WhatsApp {SITE.whatsapp}</a>
          </div>
        </div>
        <form class="form-card" action="https://formspree.io/f/REPLACE_ME" method="POST">
          <div style="font-size:13px;color:var(--c-faint);letter-spacing:1px;margin-bottom:20px">预约咨询</div>
          <div class="form-row">
            <input class="form-input" name="name" placeholder="姓名" required />
            <input class="form-input" name="wechat" placeholder="微信号" required />
          </div>
          <input class="form-input" name="email" type="email" placeholder="邮箱（用于发评估报告）" required />
          <select class="form-input" name="grade">
            <option value="">目前年级</option>
            <option>初中 / 美高准备</option>
            <option>高一 / 高二</option>
            <option>高三 / 申请季</option>
            <option>大一 / 大二</option>
            <option>大三 / 大四</option>
            <option>已毕业 / 在工作</option>
          </select>
          <select class="form-input" name="service">
            <option value="">意向服务</option>
            <option>美本申请</option><option>美硕申请</option><option>博士申请</option>
            <option>转学</option><option>签证 / 身份</option>
          </select>
          <textarea class="form-input" name="message" style="min-height:80px;resize:none" placeholder="想聊的具体问题（可选）"></textarea>
          <button type="submit" class="btn btn-primary" style="width:100%;padding:15px;font-size:15px;margin-top:10px">提交，获取免费评估 →</button>
          <div style="font-size:11px;color:var(--c-faint);margin-top:14px;text-align:center">✓ 24 小时内真人回复 · ✓ 不会有销售骚扰 · ✓ 信息严格保密</div>
        </form>
      </div>
    </div>
  </section>
</Base>

<style>
.hero { padding: 120px 0 96px; background: linear-gradient(180deg, #fff 0%, #fafafa 100%); border-bottom: 1px solid var(--c-border); }
.hero-inner { max-width: 1100px; margin: 0 auto; padding: 0 var(--pad-x); text-align: center; }
.hero-tag { display: inline-flex; align-items: center; gap: 10px; padding: 8px 16px; background: #fff; border: 1px solid var(--c-border); border-radius: 99px; font-size: 13px; color: #333; box-shadow: 0 2px 8px rgba(0,0,0,.04); }
.hero-tag-dot { width: 8px; height: 8px; border-radius: 99px; background: var(--c-green); box-shadow: 0 0 0 4px rgba(34,197,94,.15); flex-shrink: 0; }
.hero-tag-dot-urgent { background: #dc2626; box-shadow: 0 0 0 4px rgba(220,38,38,.15); animation: hero-pulse 2s ease-in-out infinite; }
.hero-tag-dot-purple { background: #7c3aed; box-shadow: 0 0 0 4px rgba(124,58,237,.15); }
.hero-tag-dot-blue { background: #0891b2; box-shadow: 0 0 0 4px rgba(8,145,178,.15); }
@keyframes hero-pulse { 0%, 100% { box-shadow: 0 0 0 4px rgba(220,38,38,.15); } 50% { box-shadow: 0 0 0 8px rgba(220,38,38,.05); } }

/* Hero carousel slides */
.hero-slides { position: relative; min-height: 460px; }
.hero-slide { position: absolute; inset: 0; opacity: 0; visibility: hidden; transition: opacity .6s ease, visibility .6s; }
.hero-slide.active { opacity: 1; visibility: visible; }
.hero-slide .hero-tag { margin-top: 0; }
.hero-slide .hero-title { margin-top: 32px; }
.hero-slide .hero-lede { margin-top: 28px; }

.hero-dots { display: flex; justify-content: center; gap: 8px; margin-top: 12px; margin-bottom: 24px; }
.hero-dot { width: 40px; height: 4px; background: rgba(0,0,0,.1); border: none; border-radius: 99px; padding: 0; cursor: pointer; position: relative; overflow: hidden; transition: background .15s; }
.hero-dot:hover { background: rgba(0,0,0,.25); }
.hero-dot.active { background: #000; }
.hero-dot-bar { display: none; }

@media (max-width: 1024px) {
  .hero-slides { min-height: 420px; }
}
@media (max-width: 768px) {
  .hero-slides { min-height: 360px; }
  .hero-dots { gap: 6px; }
  .hero-dot { width: 28px; height: 3px; }
}
.hero-title { font-size: 88px; font-weight: 700; line-height: 1.02; letter-spacing: -3.5px; margin-top: 32px; }
.hero-lede { font-size: 20px; line-height: 1.6; color: #444; margin-top: 32px; max-width: 680px; margin-left: auto; margin-right: auto; }
.hero-ctas { display: flex; gap: 12px; margin-top: 40px; justify-content: center; flex-wrap: wrap; }
.hero-micro { display: flex; gap: 32px; justify-content: center; margin-top: 40px; flex-wrap: wrap; }
.hero-micro-item { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--c-muted); }
.hero-micro-icon { color: var(--c-green); }
.big-num-row { display: grid; grid-template-columns: repeat(4, 1fr); margin-top: 80px; padding: 40px 0; border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border); }
.big-num-cell { text-align: center; border-right: 1px solid var(--c-border); padding: 8px 16px; }
