---
import Base from '../layouts/Base.astro';
import { SERVICES } from '../data/site.js';
---
<Base title="服务项目 · Maginex" description="美本 / 美硕 / 博士 / 转学 / 签证 — 全周期服务">
  <section class="hero">
    <div class="container" style="text-align:center;max-width:900px">
      <div class="eyebrow">SERVICES · 服务项目</div>
      <h1 style="font-size:72px;font-weight:700;letter-spacing:-2.5px;line-height:1.05;margin-top:14px">从美高到博士，<br/><span class="hl">全周期</span>。</h1>
      <p style="font-size:18px;color:#444;line-height:1.7;margin-top:24px">每一项服务都有标准化流程、固定价格、写在合同里的承诺。</p>
    </div>
  </section>
  <section class="section">
    <div class="container">
      <div class="serv-list">
        {SERVICES.map((s, i) => (
          <article id={s.id} class="card serv-row">
            <div class="serv-num">0{i+1}</div>
            <div style="flex:1">
              <h2 style="font-size:32px;font-weight:700;letter-spacing:-.8px">{s.title}</h2>
              <div style="font-size:16px;color:var(--c-muted);margin-top:8px">{s.sub}</div>
              <div style="font-size:13px;color:#999;margin-top:16px">建议开始时间：{s.from}</div>
              <a href="/contact/" class="btn btn-primary" style="margin-top:24px">咨询此服务 →</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
<style>
.hero { padding: 88px 0 56px; }
.serv-list { display: flex; flex-direction: column; gap: 16px; }
.serv-row { display: flex; gap: 32px; padding: 40px; }
.serv-num { font-size: 64px; font-weight: 700; color: var(--c-faint); letter-spacing: -2px; line-height: 1; }
@media (max-width: 768px) {
  .hero h1 { font-size: 40px !important; }
  .serv-row { padding: 24px; gap: 16px; flex-direction: column; }
  .serv-num { font-size: 32px; }
}
</style>
