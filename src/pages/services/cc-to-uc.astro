---
import Base from '../../layouts/Base.astro';
import {
  UC_RANKINGS, TRANSFER_MAP, REGIONS, CA_OUTLINE, CA_COLLEGES,
  COMPARE, GUARANTEES_4, COURSE_FACTS, AUDIENCE, TIMELINE, FALL2024,
} from '../../data/cc-to-uc.js';

// 经纬度 → SVG 投影（viewBox 0 0 320 600），等距投影，加州可辨识
const project = (lon, lat) => [
  +(30 + (lon + 124.5) / 10.5 * 270).toFixed(1),
  +(20 + (42.1 - lat) / 9.7 * 560).toFixed(1),
];
const outlinePath = CA_OUTLINE.map((p, i) => `${i ? 'L' : 'M'}${project(p[0], p[1]).join(',')}`).join(' ') + ' Z';
const regionColor = Object.fromEntries(REGIONS.map(r => [r.key, r.color]));
// 气泡半径：有转入人数 → 按量缩放；无数据 → 小点
const rOf = (n) => n ? 4 + Math.min(n, 1000) / 1000 * 15 : 3;
// 投影 + 排序：合作院校排在最后（渲染在最上层 → 始终可点 + 视觉突出）；
// 同组内大气泡先画、小点叠上，保证 115 所都看得见。
const placed = CA_COLLEGES
  .map(c => ({ ...c, xy: project(c.lon, c.lat), r: rOf(c.n) }))
  .sort((a, b) => (a.partner ? 1 : 0) - (b.partner ? 1 : 0) || b.r - a.r);
const topCC = [...CA_COLLEGES].filter(c => c.n).sort((a, b) => b.n - a.n).slice(0, 6);
const maxCampus = Math.max(...TRANSFER_MAP.byCampus.map(c => c.n));
const collegeCount = CA_COLLEGES.length;
const regionLabel = Object.fromEntries(REGIONS.map(r => [r.key, r.label]));
// 深度合作院校（UCB/UCLA 转学录取率最高），按转入人数排序编号
const partners = CA_COLLEGES.filter(c => c.partner).sort((a, b) => b.n - a.n)
  .map(c => ({ ...c, xy: project(c.lon, c.lat), r: rOf(c.n) }));
const partnerNames = partners.map(p => p.name);

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "CC 转 UC 和直接申请 UC 有什么区别？", "acceptedAnswer": { "@type": "Answer", "text": "直接申请 UC 本科需要托福 81-115 / 雅思 6-7.5 / SAT 1250-1550 / GPA 3.2-4.0；而美国社区大学转学 UC 八大无托福雅思成绩要求、无高 GPA 要求，满足高中及以上学历即可申请，仅需修满 60 学分直录本科大三。转学毕业颁发的学位证书与本科直申完全一致，全球认可。" } },
    { "@type": "Question", "name": "社区大学转学 UC 的成功率高吗？", "acceptedAnswer": { "@type": "Answer", "text": "高。UC 系统每年录取的转学生绝大多数来自加州社区大学。2024Fall UC 共收到 43,543 份转学申请，其中 34,668 份来自加州社区大学（CCC）。Santa Monica、De Anza、Diablo Valley、Pasadena City 等强校每年向 UC 输送数百名转学生。" } },
    { "@type": "Question", "name": "整个项目要多久、多少钱？", "acceptedAnswer": { "@type": "Answer", "text": "课程时长 1 年 / 1.5 年 / 2 年可选，最快一年完成转学、继读两年获本科学位。社区大学学费约 8,000-12,000 美金/年，整体费用（学费 + 服务费）约 8-10W 美金，同比直申节省学费 60,000-80,000 美金。开课时间每年 1、5、8、10 月共四次。" } },
    { "@type": "Question", "name": "社区大学是降级吗？学历回国认可吗？", "acceptedAnswer": { "@type": "Answer", "text": "不是。美国社区大学 ≠ 国内职高/技校，转学 UC 八大 ≠ 国内专升本。CC → UC 是加州官方的主流升学路径，转学后从 UC 大三读起，最终颁发的学位证书与本科直申完全一致，全球范围认可，回国可做学历认证。" } },
  ],
};
---
<Base title="CC 转 UC 名校直通车 · 社区大学转学加州大学 · Maginex" description="美国社区大学转 UC 八大名校（UCB/UCLA/UCSD/UCI/UCSB 等）。无需托福雅思、修满 60 学分直录本科大三。加州转学地图 + 完整时间线 + UC 录取数据公开。">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqJsonLd)}></script>

  <!-- HERO -->
  <section class="serv-page-hero cc-hero">
    <div class="container" style="max-width:920px">
      <div class="crumb"><a href="/">首页</a> / <a href="/services/">服务</a> / <span>CC 转 UC</span></div>
      <div class="serv-hero-tag cc-tag">★ 核心服务 · UC 名校快捷直通车</div>
      <h1 class="serv-hero-h1">从社区大学，<br/>直通<span class="hl">UC 八大名校</span>。</h1>
      <p class="serv-hero-lede">北美大学均接受从 College 修完前两年课程、拿到 <strong>60 学分</strong>后转入 University 读完后两年毕业。我们通过专业课程辅导帮你拿到<strong>高 GPA</strong>，从而转入 UCB、UCLA、UCSD、UCI、UCSB 等世界一流名校——<strong>无需托福雅思、无需高考成绩</strong>，直录本科大三。</p>
      <div class="cc-hero-pills">
        <span>仅需 60 学分</span><span>无托福 / 雅思</span><span>直录大三</span><span>最快 1 年转学</span><span>省学费 6–8 万美金</span>
      </div>
      <div class="serv-hero-ctas">
        <button type="button" data-wechat-cta="cc-to-uc-hero" class="btn btn-primary btn-lg"><span style="margin-right:8px">●</span>免费评估转学路径 →</button>
        <a href="/contact/" class="btn btn-ghost btn-lg">填表预约（30 分钟评估）</a>
      </div>
      <p class="cc-partner-line">★ 与 Santa Monica、De Anza、Diablo Valley 等 UCB / UCLA 转学强校<a href="#cc-map-wrap">深度合作</a>。</p>
    </div>
  </section>

  <!-- 流程时间表（流程图时间表）-->
  <section class="serv-page-section">
    <div class="container" style="max-width:1040px">
      <div class="eyebrow">PROJECT PROCESS · 转学流程时间表</div>
      <h2 class="sp-h2">4 步直通，最快 <span class="hl">1.5–2 年</span> 拿名校本科学位。</h2>
      <div class="tl">
        <div class="tl-axis">
          {TIMELINE.map((s, i) => (
            <div class="tl-node" style={`--i:${i}`}>
              <div class="tl-dot"></div>
              {i < TIMELINE.length - 1 && <div class="tl-line"></div>}
              <div class="tl-card">
                <div class="tl-card-head">
                  <span class="tl-phase">{s.phase}</span>
                  <span class="tl-term">{s.term}</span>
                </div>
                <div class="tl-title">{s.title}</div>
                <p class="tl-desc">{s.desc}</p>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </section>

  <!-- 加州转学地图（地图）-->
  <section class="serv-page-section section-soft">
    <div class="container" style="max-width:1100px">
      <div class="eyebrow">INTERACTIVE MAP · 加州社区大学转学地图</div>
      <h2 class="sp-h2">{collegeCount} 所社区大学全在图上，<span class="hl">{partners.length} 所深度合作</span>直通 UCB / UCLA。</h2>
      <p class="sp-lede-2">气泡<strong>大小 = 转入 UC 人数</strong>（UC Data Warehouse, Fall 2023），<strong>颜色 = 所在地区</strong>。<span class="gold-text">★ 金圈标注的是 Maginex 深度合作院校</span>——它们转入 <strong>UC Berkeley / UCLA 的录取率全加州最前列</strong>，我们与其长期对接选课、学分与转学资源。<span class="map-hint">在地图上悬停或点击任意学校查看详情。</span></p>

      <div class="map-controls">
        <div class="map-chips">
          <button type="button" class="map-chip is-active" data-filter="all">全部 {collegeCount} 所</button>
          <button type="button" class="map-chip map-chip-gold" data-filter="partner">★ 深度合作院校 {partners.length}</button>
        </div>
        <input id="cc-search" class="map-search" type="search" placeholder="🔍 搜索社区大学（中 / 英文）…" autocomplete="off" aria-label="搜索社区大学" />
      </div>

      <div class="map-wrap" id="cc-map-wrap">
        <div class="map-svg-box">
          <svg viewBox="0 0 320 600" class="ca-map" id="cc-map-svg" role="img" aria-label="加州 116 所社区大学转学 UC 交互地图">
            <path d={outlinePath} fill="#fff" stroke="#d4d4d4" stroke-width="1.4" stroke-linejoin="round"/>
            {placed.map((c) => (
              <g class={`cc-bubble${c.partner ? ' is-partner' : ''}`}
                 data-name={c.name} data-n={c.n || ''} data-region={regionLabel[c.region]}
                 data-partner={c.partner ? '1' : ''} data-uc={c.partnerUC || ''} data-note={c.partnerNote || ''}
                 role={c.partner ? 'button' : null} tabindex={c.partner ? '0' : null}
                 aria-label={c.partner ? `${c.name}，深度合作院校` : null}>
                {c.partner && <circle class="cc-ring" cx={c.xy[0]} cy={c.xy[1]} r={c.r + 3.5} fill="none" stroke="#caa033" stroke-width="2"/>}
                <circle class="cc-dot" cx={c.xy[0]} cy={c.xy[1]} r={c.r}
                  fill={regionColor[c.region]} fill-opacity={c.n ? 0.6 : 0.85}
                  stroke={regionColor[c.region]} stroke-width="1" stroke-opacity="0.9"/>
              </g>
            ))}
            <g class="partner-badges">
              {partners.map((p, i) => (
                <g class="pbadge" data-target={p.name}>
                  <circle cx={+(p.xy[0] + p.r * 0.7 + 5).toFixed(1)} cy={+(p.xy[1] - p.r * 0.7 - 5).toFixed(1)} r="7" fill="#caa033" stroke="#fff" stroke-width="1.5"/>
                  <text x={+(p.xy[0] + p.r * 0.7 + 5).toFixed(1)} y={+(p.xy[1] - p.r * 0.7 - 5 + 3).toFixed(1)} text-anchor="middle" font-size="9" font-weight="700" fill="#fff">{i + 1}</text>
                </g>
              ))}
            </g>
          </svg>
          <div class="map-size-legend">
            <span class="msl-title">气泡大小 = 转入 UC 人数</span>
            <span class="msl-row"><span class="msl-c" style="width:7px;height:7px"></span>数据较小 / 未公开</span>
            <span class="msl-row"><span class="msl-c" style="width:13px;height:13px"></span>~300</span>
            <span class="msl-row"><span class="msl-c" style="width:23px;height:23px"></span>~1000</span>
            <span class="msl-row"><span class="msl-c msl-gold"></span>★ 深度合作院校</span>
          </div>
          <div class="cc-tip" id="cc-tip" hidden></div>
        </div>

        <div class="map-side">
          <div id="cc-info" class="cc-info">
            <div class="cc-info-h"><span class="gold-star">★</span> Maginex 深度合作院校</div>
            <p class="cc-info-sub">UCB / UCLA 转学录取率最高的 {partners.length} 所，我们长期对接选课、学分规划与转学名额。</p>
            <div class="partner-cards">
              {partners.map((p, i) => (
                <button type="button" class="partner-card" data-target={p.name}>
                  <span class="pc-no">{i + 1}</span>
                  <span class="pc-body">
                    <span class="pc-name">{p.name}</span>
                    <span class="pc-meta"><span class="pc-uc">{p.partnerUC}</span><span class="pc-n">转入 {p.n} 人</span></span>
                    <span class="pc-note">{p.partnerNote}</span>
                  </span>
                </button>
              ))}
            </div>
            <button type="button" data-wechat-cta="cc-map-partner" class="cc-info-cta">问问能不能从这些校转 UC →</button>
          </div>

          <details class="map-extra">
            <summary>各 UC 校区转入数据 + 地区图例</summary>
            <div class="region-legend">
              <div class="map-side-title">颜色 = 所在地区</div>
              <div class="rl-grid">
                {REGIONS.map((r) => (
                  <span class="rl-item"><span class="rl-dot" style={`background:${r.color}`}></span>{r.label}</span>
                ))}
              </div>
            </div>
            <div class="map-side-title" style="margin-top:18px">各 UC 校区转入总人数<span>Fall 2023</span></div>
            <div class="campus-bars">
              {TRANSFER_MAP.byCampus.map((c) => (
                <div class="cbar-row">
                  <span class="cbar-name">{c.name}</span>
                  <span class="cbar-track">
                    <span class="cbar-fill" style={`width:${Math.max(c.n / maxCampus * 100, 4)}%;background:${TRANSFER_MAP.destColors[c.name] || '#9aa'}`}></span>
                  </span>
                  <span class="cbar-n">{c.n.toLocaleString()}</span>
                </div>
              ))}
            </div>
          </details>
        </div>
      </div>
      <p class="map-note">注：气泡按各校城市经纬度投影定位（示意级精度）。转入人数为 UC Data Warehouse Fall 2023 口径，部分小规模 / 新设学院无公开细分数据，按小点显示其位置。深度合作关系以双方实际签约为准。</p>
    </div>
  </section>

  <!-- 项目优势：直申 VS 直通车 -->
  <section class="serv-page-section">
    <div class="container" style="max-width:980px">
      <div class="eyebrow">ADVANTAGES · 项目优势</div>
      <h2 class="sp-h2">本科直申 <span style="color:#bbb">VS</span> 快捷直通车，<span class="hl">四个维度全面碾压</span>。</h2>
      <div class="cmp-list">
        {COMPARE.map((row) => (
          <div class="cmp-row">
            <div class="cmp-theme">{row.theme}</div>
            <div class="cmp-cols">
              <div class="cmp-col cmp-direct">
                <div class="cmp-col-h">本科直申</div>
                <ul>{row.direct.map(t => <li>{t}</li>)}</ul>
              </div>
              <div class="cmp-vs">VS</div>
              <div class="cmp-col cmp-fast">
                <div class="cmp-col-h">快捷直通车</div>
                <ul>{row.fast.map(t => <li>{t}</li>)}</ul>
              </div>
            </div>
          </div>
        ))}
      </div>

      <div class="g4-grid">
        {GUARANTEES_4.map((g) => (
          <div class="g4-card">
            <div class="g4-tag">{g.tag}</div>
            <div class="g4-title">{g.title}</div>
            <div class="g4-desc">{g.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 课程介绍 -->
  <section class="serv-page-section section-soft">
    <div class="container" style="max-width:980px">
      <div class="eyebrow">COURSE · 课程介绍</div>
      <h2 class="sp-h2">一张表看清<span class="hl">怎么上课、怎么转</span>。</h2>
      <div class="facts-grid">
        {COURSE_FACTS.map((f) => (
          <div class="fact-card">
            <div class="fact-k">{f.k}</div>
            <div class="fact-v">{f.v}</div>
          </div>
        ))}
      </div>
      <div class="sell-grid">
        <div class="sell-card"><div class="sell-h">教学支撑保障</div><p>拥有社区大学课程学分辅导专业团队，确保学生高分转学无风险。</p></div>
        <div class="sell-card"><div class="sell-h">课程设置合理</div><p>主修四年制本科院校大一、大二通识基础课，与 UC 八大大三课程完美无缝衔接。</p></div>
        <div class="sell-card"><div class="sell-h">时间地点不设限</div><p>国内 / 国外皆可报名上课，课时可根据个人情况灵活选择。</p></div>
      </div>
    </div>
  </section>

  <!-- UC 排名表 -->
  <section class="serv-page-section">
    <div class="container" style="max-width:980px">
      <div class="eyebrow">UC RANKINGS · 转学合作院校</div>
      <h2 class="sp-h2">UC 八大，<span class="hl">全美 Top 36 全覆盖</span>。</h2>
      <div class="rank-table">
        <div class="rank-head">
          <span>序号</span><span>学校</span><span>全美</span><span>全球</span>
        </div>
        {UC_RANKINGS.map((u) => (
          <details class="rank-item">
            <summary>
              <span class="rk-no" style={`color:${u.color}`}>{u.rank}</span>
              <span class="rk-school"><b>{u.en}</b><i>{u.cn}</i></span>
              <span class="rk-us">#{u.us}</span>
              <span class="rk-world">#{u.world}</span>
            </summary>
            <p class="rk-strength"><span class="rk-bar" style={`background:${u.color}`}></span>{u.strength}</p>
          </details>
        ))}
      </div>
      <p class="map-note">排名口径：2024 U.S. News 全美 / 全球排名。点击每一行展开优势专业。</p>
    </div>
  </section>

  <!-- 24Fall 数据 -->
  <section class="serv-page-section section-dark cc-data">
    <div class="container" style="max-width:980px">
      <div class="eyebrow" style="color:rgba(255,255,255,.5)">DATA · 2024 Fall UC 录取概况</div>
      <h2 class="sp-h2" style="color:#fff">社区大学转学，<span class="hl">已是 UC 的主流入口</span>。</h2>
      <div class="data-grid">
        {FALL2024.map((d) => (
          <div class="data-card">
            <div class="data-num">{d.num}</div>
            <div class="data-label">{d.label}</div>
            <div class="data-sub">{d.sub}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 针对人群 -->
  <section class="serv-page-section">
    <div class="container" style="max-width:980px">
      <div class="eyebrow">FOR THE CROWD · 针对人群</div>
      <h2 class="sp-h2">这 4 类学生，<span class="hl">最适合走直通车</span>。</h2>
      <div class="aud-grid">
        {AUDIENCE.map((a, i) => (
          <div class="aud-card">
            <div class="aud-num">0{i+1}</div>
            <div class="aud-title">{a.title}</div>
            <div class="aud-desc">{a.desc}</div>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- 配对阅读 -->
  <section class="serv-page-section section-soft">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">RESOURCES · 配对阅读</div>
      <a href="/resources/gpa-low-transfer/" class="sp-resource-card">
        <div style="font-size:11px;color:#999;letter-spacing:2px">转学 · 15 分钟阅读</div>
        <div style="font-size:22px;font-weight:700;margin-top:10px;letter-spacing:-.4px">GPA 2.3 还有救吗？从 Community College 到 UC 的真实路径</div>
        <div style="font-size:14px;color:#666;margin-top:10px;line-height:1.6">UC 系统 92% transfer 录取来自 CC。IGETC + TAG + 选 CC 标准 + UC 申请季 3 个隐藏规则。</div>
        <div style="margin-top:14px;font-size:13px;font-weight:600">阅读全文 →</div>
      </a>
      <a href="/services/urgent-transfer/" class="sp-resource-card" style="margin-top:14px">
        <div style="font-size:11px;color:#999;letter-spacing:2px">紧急转学 · 服务</div>
        <div style="font-size:22px;font-weight:700;margin-top:10px;letter-spacing:-.4px">原校念不下去？48h 内紧急转 CC 保 F-1 不断档</div>
        <div style="font-size:14px;color:#666;margin-top:10px;line-height:1.6">已收 dismissal / 财务断流 / 想换专业——先稳住身份，再走 CC → UC 长线。</div>
        <div style="margin-top:14px;font-size:13px;font-weight:600">了解详情 →</div>
      </a>
    </div>
  </section>

  <!-- FINAL CTA -->
  <section class="final-cta section-dark">
    <div class="container">
      <div style="text-align:center">
        <h2 style="font-size:60px;font-weight:700;letter-spacing:-2px;line-height:1.06">想用 <span class="hl">CC 的成本</span><br/>拿 UC 的学位？</h2>
        <p style="font-size:16px;color:rgba(255,255,255,.7);line-height:1.7;margin-top:24px;max-width:560px;margin-left:auto;margin-right:auto">把你的学历背景、目标专业微信发我们，免费 30 分钟评估转学路径 + 给出 CC 选校与时间线建议。0 销售骚扰。</p>
        <div style="display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;justify-content:center">
          <button type="button" data-wechat-cta="cc-to-uc-final" class="btn btn-primary btn-lg">立即微信咨询 →</button>
          <a href="/contact/" class="btn btn-ghost btn-lg" style="color:#fff;border-color:rgba(255,255,255,.2)">填表预约</a>
        </div>
      </div>
    </div>
  </section>
  <script is:inline>
    (function () {
      const wrap = document.getElementById('cc-map-wrap');
      if (!wrap) return;
      const svg = document.getElementById('cc-map-svg');
      const tip = document.getElementById('cc-tip');
      const info = document.getElementById('cc-info');
      const defaultHTML = info.innerHTML;
      const search = document.getElementById('cc-search');
      const chips = Array.from(document.querySelectorAll('.map-chip'));
      const bubbles = Array.from(svg.querySelectorAll('.cc-bubble'));
      const byName = {};
      bubbles.forEach(function (b) { byName[b.dataset.name] = b; });

      function clearDim() { bubbles.forEach(function (b) { b.classList.remove('dim'); }); wrap.classList.remove('dimmed'); }
      function clearSelect() { bubbles.forEach(function (b) { b.classList.remove('is-selected'); }); }

      // tooltip
      function moveTip(e) {
        const box = svg.getBoundingClientRect();
        let x = e.clientX - box.left + 12, y = e.clientY - box.top + 12;
        if (x > box.width - 150) x = e.clientX - box.left - 150;
        tip.style.left = x + 'px'; tip.style.top = y + 'px';
      }
      function showTip(g, e) {
        const n = g.dataset.n, p = g.dataset.partner;
        tip.innerHTML = '<b>' + g.dataset.name + '</b>' + (n ? ' · 转入 UC ' + n + ' 人' : '') +
          (p ? '<span class="tip-gold">★ Maginex 深度合作院校</span>' : '');
        tip.hidden = false; moveTip(e);
      }
      function hideTip() { tip.hidden = true; }

      // panel detail
      function showDetail(g) {
        const d = g.dataset, n = d.n, p = d.partner;
        let html = '<button type="button" class="cc-back">← 返回合作院校</button>' +
          '<div class="cc-d-name">' + d.name + '</div>' +
          '<div class="cc-d-meta">' + d.region + (n ? ' · 转入 UC ' + n + ' 人（Fall 2023）' : ' · 暂无公开转入细分数据') + '</div>';
        if (p) {
          html += '<div class="cc-d-partner"><div class="cc-d-partner-h"><span class="pc-uc">' + d.uc + '</span> ★ Maginex 深度合作院校</div><p>' + d.note + '</p></div>';
        }
        html += '<button type="button" data-wechat-cta="cc-map-' + (p ? 'partner-detail' : 'college') + '" class="cc-d-cta">咨询从这所学校转 UC →</button>';
        info.innerHTML = html;
        info.querySelector('.cc-back').addEventListener('click', restore);
      }
      function restore() { info.innerHTML = defaultHTML; bindCards(); clearSelect(); }
      function select(g) { clearSelect(); g.classList.add('is-selected'); showDetail(g); }

      function bindCards() {
        info.querySelectorAll('.partner-card, .pbadge').forEach(function (el) {
          el.addEventListener('click', function () {
            const g = byName[el.dataset.target]; if (g) { clearDim(); select(g); }
          });
        });
      }

      bubbles.forEach(function (g) {
        g.addEventListener('mouseenter', function (e) { showTip(g, e); });
        g.addEventListener('mousemove', moveTip);
        g.addEventListener('mouseleave', hideTip);
        g.addEventListener('click', function () { select(g); });
        g.addEventListener('keydown', function (e) { if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); select(g); } });
      });
      // badges clickable → focus partner
      Array.from(svg.querySelectorAll('.pbadge')).forEach(function (b) {
        b.style.pointerEvents = 'auto'; b.style.cursor = 'pointer';
        b.addEventListener('click', function () { const g = byName[b.dataset.target]; if (g) { clearDim(); select(g); } });
      });

      // filter chips
      chips.forEach(function (ch) {
        ch.addEventListener('click', function () {
          chips.forEach(function (c) { c.classList.remove('is-active'); });
          ch.classList.add('is-active');
          if (search) search.value = '';
          clearDim(); clearSelect(); restore();
          wrap.classList.toggle('only-partner', ch.dataset.filter === 'partner');
        });
      });

      // search
      if (search) search.addEventListener('input', function () {
        const q = search.value.trim().toLowerCase();
        wrap.classList.remove('only-partner');
        chips.forEach(function (c) { c.classList.remove('is-active'); });
        if (!q) { clearDim(); chips[0].classList.add('is-active'); return; }
        wrap.classList.add('dimmed');
        bubbles.forEach(function (b) { b.classList.toggle('dim', b.dataset.name.toLowerCase().indexOf(q) === -1); });
      });

      bindCards();
    })();
  </script>
</Base>

