---
import Base from '../../layouts/Base.astro';

const faqJsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  "mainEntity": [
    { "@type": "Question", "name": "Academic Probation 和 Dismissal 有什么区别？", "acceptedAnswer": { "@type": "Answer", "text": "Probation 是警告（GPA 低于 2.0 通常触发），还能继续注册，必须在 1-2 学期内回到 good standing。Dismissal 是开除，强制离校。Suspension 介于两者之间，强制中断 1-2 学期。USCIS 关心的是 SEVIS 状态——只要学校没把你 SEVIS terminate，你的 F-1 就还在。" } },
    { "@type": "Question", "name": "申诉成功率有多高？", "acceptedAnswer": { "@type": "Answer", "text": "看类型。基于 procedural error（学校未给你充分通知 / 未给你听证机会）的申诉成功率约 50-60%；基于 new evidence（新发现的医疗 / 家庭证据）的申诉成功率约 35-45%；基于 disproportionate sanction（处罚过重）的申诉成功率最低（约 15-20%）。最有希望的策略是叠加 procedural + medical 双轨论证。" } },
    { "@type": "Question", "name": "申诉期间我能继续上课吗？", "acceptedAnswer": { "@type": "Answer", "text": "通常可以，看学校政策。多数学校在 appeal pending 期间允许学生继续注册（standard FERPA 保护），但部分学校会给「conditional enrollment」——你出席但成绩不计入。咨询 Dean of Students Office 确认具体政策。" } },
    { "@type": "Question", "name": "如果申诉失败会怎样？", "acceptedAnswer": { "@type": "Answer", "text": "申诉失败 = dismissal 生效 = SEVIS 60 天内 terminate（学校可延迟 file，给你时间转学）。这时主要路径是紧急转学（CC / Day 1 CPT）+ 同步申请 USCIS reinstatement (I-539)。详见《被开除 7 天》文章。" } },
  ],
};
---
<Base title="学术 dismissal 申诉服务 · Maginex" description="Academic Probation / Suspension / Dismissal 申诉。基于 procedural error / new evidence / disproportionate sanction 三轨论证。当晚响应 + 21 天内出申诉信定稿。">
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(faqJsonLd)}></script>

  <section class="serv-page-hero">
    <div class="container" style="max-width:880px">
      <div class="crumb"><a href="/">首页</a> / <a href="/services/">服务</a> / <span>学术 dismissal 申诉</span></div>
      <div class="serv-hero-tag"><span class="urgent-dot"></span> Tier 1 紧急 · 当晚响应</div>
      <h1 class="serv-hero-h1">收到 academic dismissal letter？<br/>这场仗还<span class="hl">没结束</span>。</h1>
      <p class="serv-hero-lede">Academic Probation / Suspension / Dismissal 是 3 个不同的处罚等级，对应 3 套不同的申诉策略。多数学校的 academic appeal procedure 给学生 5-21 天 window 提交正式申诉——错过 = 处罚生效。我们当晚响应，21 天内出申诉信定稿 + 听证会准备。</p>
      <div class="serv-hero-ctas">
        <button type="button" data-wechat-cta="academic-appeal-hero" class="btn btn-primary btn-lg" style="background:#dc2626"><span style="margin-right:8px">●</span>当晚微信咨询 →</button>
        <a href="/contact/" class="btn btn-ghost btn-lg">填表预约（30 分钟评估）</a>
      </div>
    </div>
  </section>

  <section class="serv-page-section">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">SCOPE · 适用场景</div>
      <h2 class="sp-h2">这 4 类情况，我们处理过：</h2>
      <div class="sp-scope-grid">
        <div class="sp-scope-card">
          <div class="sp-scope-num">01</div>
          <div class="sp-scope-title">GPA 滑坡触发 academic probation / suspension</div>
          <div class="sp-scope-desc">连续两学期 GPA 低于 2.0 / 收到 academic warning letter / 临 probation 边界 GPA 1.7-2.0</div>
        </div>
        <div class="sp-scope-card">
          <div class="sp-scope-num">02</div>
          <div class="sp-scope-title">被指控 honor code violation</div>
          <div class="sp-scope-desc">Plagiarism / unauthorized collaboration / cheating 指控 - 学校已开始 academic integrity hearing 流程</div>
        </div>
        <div class="sp-scope-card">
          <div class="sp-scope-num">03</div>
          <div class="sp-scope-title">已收到 dismissal letter，appeal window 倒计时</div>
          <div class="sp-scope-desc">学校已下 final dismissal decision，给你 5-21 天提交 formal appeal——错过 = 处罚生效 + SEVIS terminate 倒计时</div>
        </div>
        <div class="sp-scope-card">
          <div class="sp-scope-num">04</div>
          <div class="sp-scope-title">First-level appeal 失败，准备 second-level / external review</div>
          <div class="sp-scope-desc">学院级申诉被驳，需要 Provost / Dean of Students 级别 second-level appeal，或 external grievance committee</div>
        </div>
      </div>
    </div>
  </section>

  <section class="serv-page-section section-soft">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">WHAT WE DO · 我们做什么</div>
      <h2 class="sp-h2">3 轨论证 · 1 套 binder · 1 次 hearing 准备：</h2>
      <ol class="sp-do-list">
        <li><strong>Procedural error 取证</strong>：核对学校 academic conduct policy 的程序条款（notice 时间、hearing 通知、evidence 提交规则）。30%+ 的 dismissal 案中学校自己违反了 procedure——这是申诉最强的论点</li>
        <li><strong>New evidence 收集</strong>：医疗诊断（心理健康 / 慢性疾病）、家庭重大变故、证人陈述、original work 证据（被指 plagiarism 时关键）</li>
        <li><strong>Disproportionate sanction 论证</strong>：对比同校历史案例的处罚 ratio（学校 academic conduct annual report 通常公开），论证 dismissal 处罚明显重于 first-time offense 的常规处理</li>
        <li><strong>申诉信主稿撰写 + 4-7 版迭代</strong>：USCIS 审查官风格的 evidence-driven writing，引用具体 policy section、具体 hearing date、具体 procedural step</li>
        <li><strong>Hearing 模拟训练</strong>：3-5 次模拟问答，覆盖 academic integrity hearing 常考的 25 个问题</li>
        <li><strong>Evidence binder 整理</strong>：tabbed binder（Tab A 程序证据 / Tab B 新证据 / Tab C 处罚比较 / Tab D 学生陈述），递交学校时一同提交</li>
        <li><strong>FERPA + 律师介入路径</strong>：如果学校处理过程涉及 FERPA 违规（隐私权违规），可叠加 FERPA complaint 给 US Department of Education</li>
      </ol>
    </div>
  </section>

  <section class="serv-page-section">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">WHAT WE DON'T DO · 我们不做什么（透明）</div>
      <div class="sp-dont-card">
        <ul class="sp-dont-list">
          <li>❌ <strong>不伪造医疗证明 / 心理诊断</strong>——伪造 disability 证明在加州属 18 USC § 1001 false statements + ADA fraud，被发现后 dismissal 升级为 immigration fraud finding，永久禁入美国</li>
          <li>❌ <strong>不替你写"假道歉信"</strong>——许多学校 honor code committee 训练有素能识别模板化道歉。真诚 + 具体行动是唯一可信的版本</li>
          <li>❌ <strong>不参与 honor code violation 的 cover-up</strong>——如果你确实违反了 academic integrity，我们的工作是<strong>降低处罚等级</strong>（accept responsibility + present mitigation），不是帮你否认</li>
          <li>❌ <strong>不保证 100% 申诉成功</strong>——真实 success rate 见上方 FAQ。任何"保过 / 保通"承诺都是话术</li>
        </ul>
      </div>
    </div>
  </section>

  <section class="serv-page-section section-soft">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">LEGAL BASIS · 法律依据</div>
      <h2 class="sp-h2">每个论点都有 enforceable 政策依据：</h2>
      <ul class="sp-legal-list">
        <li><strong>FERPA (Family Educational Rights and Privacy Act)</strong> · 学生有权获得 academic record 完整副本 + 程序违规可向 US Dept of Education file complaint</li>
        <li><strong>各校 Academic Conduct Policy / Honor Code</strong> · 通常公开发布在 Dean of Students 网站。"Notice" "Hearing" "Evidence" 三个程序条款是最常被违反的</li>
        <li><strong>Title IX</strong> · 当涉及性别 / 性骚扰相关 academic dispute 时适用</li>
        <li><strong>ABA Model Rules of Professional Conduct</strong> · 如果学校 in-house counsel 在 hearing 中存在 conflict of interest</li>
        <li><strong>State Anti-Discrimination Statutes</strong> · 涉及种族 / 国籍 / 残疾基础的 disparate treatment 时适用</li>
      </ul>
    </div>
  </section>

  <section class="serv-page-section">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">CASE · 实战案例</div>
      <div class="case-box">
        <div class="case-head">
          <div class="case-init">Z</div>
          <div>
            <div style="font-size:14px;font-weight:600">张同学 · 加州某私校 · academic dismissal 申诉</div>
            <div style="font-size:12px;color:#999;margin-top:2px">2024 春，连续两学期 GPA 1.8 触发 dismissal</div>
          </div>
        </div>
        <p><strong>Day 1</strong>：张同学凌晨 1 点收到 final dismissal letter，appeal 窗口 14 天。情绪崩溃。</p>
        <p><strong>Day 2</strong>：免费 30 分钟评估。我们核对 academic conduct policy，发现 1 处程序漏洞——学校未给学生 academic warning hearing 的 7 天书面通知（policy 要求 14 天）。这是关键论点。</p>
        <p><strong>Day 3-7</strong>：收集证据：父亲 2024 春重病诊断书 + 心理咨询记录（学校 counseling center 出具）+ 室友证人陈述。</p>
        <p><strong>Day 8-12</strong>：申诉信迭代 5 版。三轨论证：（A）程序违规（缺通知）；（B）家庭因素影响学习能力（新证据）；（C）学校历史案例中类似 GPA 区间多以 probation 处理（处罚比较）。</p>
        <p><strong>Day 13</strong>：递交申诉 + 完整 evidence binder。</p>
        <p><strong>Day 18</strong>：second-level appeal hearing。模拟 4 次后表现稳定。</p>
        <p><strong>Day 23</strong>：学校决定——dismissal 改为 academic probation + 1 学期。允许 Fall 2024 注册。</p>
        <p style="margin-top:14px;font-style:italic;color:#666">从 dismissal 到保留学籍：23 天。如果 Day 1 错过 14 天 appeal window，结果完全不同。</p>
      </div>
    </div>
  </section>

  <section class="serv-page-section section-soft">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">PRICING · 价位段</div>
      <h2 class="sp-h2">$$ · 5,000–15,000 美元区间</h2>
      <p style="font-size:15px;color:#444;line-height:1.8;margin-top:18px">具体报价在 30 分钟免费评估后给出，按以下因素拆解：</p>
      <ul style="font-size:14px;color:#444;line-height:1.9;padding-left:24px;margin-top:8px">
        <li>申诉级别（first-level appeal vs Provost-level second appeal）</li>
        <li>是否需要 hearing 模拟训练 + 律师介入</li>
        <li>是否需要叠加 FERPA complaint / external grievance</li>
        <li>case 复杂度（pure GPA dismissal 较简单 / honor code violation 较复杂）</li>
      </ul>
      <p style="font-size:14px;color:#666;margin-top:18px"><strong>退费规则</strong>：如学校最终维持原 dismissal 决定 → 退服务费 50%。律师 file fee / 学校 hearing fee 等第三方费用按规定不可退。条款已过律所公证。</p>
    </div>
  </section>

  <section class="serv-page-section">
    <div class="container" style="max-width:880px">
      <div class="eyebrow">RESOURCES · 配对阅读</div>
      <a href="/resources/expelled-7-days/" class="sp-resource-card">
        <div style="font-size:11px;color:#999;letter-spacing:2px">学术急救 · 12 分钟阅读</div>
        <div style="font-size:22px;font-weight:700;margin-top:10px;letter-spacing:-.4px">收到学校开除信后，前 7 天必须做的 9 件事</div>
        <div style="font-size:14px;color:#666;margin-top:10px;line-height:1.6">收到 dismissal letter 不等于身份立即失效。你有一个 15 天的关键窗口期 — 这是步骤清单。</div>
        <div style="margin-top:14px;font-size:13px;font-weight:600">阅读全文 →</div>
      </a>
    </div>
  </section>

  <section class="final-cta section-dark">
    <div class="container">
      <div class="final-grid" style="display:flex;align-items:center;justify-content:center;text-align:center">
        <div>
          <h2 class="h2-huge" style="font-size:64px;letter-spacing:-2px;line-height:1.05">收到 dismissal letter？<br/><span class="hl">今晚就开始。</span></h2>
          <p style="font-size:16px;color:rgba(255,255,255,.7);line-height:1.7;margin-top:24px;max-width:560px;margin-left:auto;margin-right:auto">把 dismissal letter 拍照微信发我们，当晚返回路径建议 + 程序漏洞初判。0 销售，0 信息转卖。</p>
          <div style="display:flex;gap:14px;margin-top:32px;flex-wrap:wrap;justify-content:center">
            <button type="button" data-wechat-cta="academic-appeal-final" class="btn btn-primary btn-lg" style="background:#dc2626">立即微信咨询 →</button>
            <a href="/contact/" class="btn btn-ghost btn-lg" style="color:#fff;border-color:rgba(255,255,255,.2)">填表预约</a>
          </div>
        </div>
      </div>
    </div>
  </section>
</Base>

<style is:global>
.serv-page-hero { padding: 64px 0 48px; background: linear-gradient(180deg, #fff, #fafafa); }
.crumb { font-size: 13px; color: #666; }
.crumb a { color: #666; }
.serv-hero-tag { display: inline-flex; align-items: center; gap: 8px; padding: 6px 14px; background: #fef2f2; border: 1px solid #fecaca; border-radius: 99px; font-size: 12px; color: #991b1b; margin-top: 14px; font-weight: 600; }
.serv-hero-tag .urgent-dot { width: 7px; height: 7px; border-radius: 99px; background: #dc2626; box-shadow: 0 0 0 3px rgba(220,38,38,.15); animation: sph-pulse 2s ease-in-out infinite; }
@keyframes sph-pulse { 0%, 100% { box-shadow: 0 0 0 3px rgba(220,38,38,.15); } 50% { box-shadow: 0 0 0 6px rgba(220,38,38,.05); } }
.serv-hero-h1 { font-size: 56px; font-weight: 700; letter-spacing: -1.5px; line-height: 1.1; margin-top: 18px; }
.serv-hero-lede { font-size: 17px; color: #444; line-height: 1.7; margin-top: 24px; max-width: 720px; }
.serv-hero-ctas { display: flex; gap: 12px; margin-top: 36px; flex-wrap: wrap; }

.serv-page-section { padding: 64px 0; }
.serv-page-section.section-soft { background: var(--c-soft); }
.sp-h2 { font-size: 32px; font-weight: 700; letter-spacing: -.6px; margin-top: 14px; line-height: 1.25; }

.sp-scope-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 14px; margin-top: 32px; }
.sp-scope-card { background: #fff; border: 1px solid var(--c-border); border-radius: 14px; padding: 22px; }
.sp-scope-num { font-size: 12px; color: var(--c-faint); letter-spacing: 2px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-weight: 700; }
.sp-scope-title { font-size: 17px; font-weight: 700; letter-spacing: -.3px; margin-top: 8px; line-height: 1.4; }
.sp-scope-desc { font-size: 13.5px; color: #555; line-height: 1.7; margin-top: 8px; }

.sp-do-list { list-style: none; padding: 0; margin: 32px 0 0; counter-reset: do; }
.sp-do-list li { position: relative; padding: 16px 0 16px 56px; border-bottom: 1px solid var(--c-border); font-size: 15px; line-height: 1.7; counter-increment: do; }
.sp-do-list li:last-child { border-bottom: none; }
.sp-do-list li::before { content: counter(do, decimal-leading-zero); position: absolute; left: 0; top: 16px; font-size: 13px; font-weight: 700; color: var(--c-muted); letter-spacing: 1px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; padding: 4px 10px; background: var(--c-soft); border-radius: 6px; }

.sp-dont-card { background: #fef2f2; border: 1px solid #fecaca; border-radius: 14px; padding: 28px; margin-top: 24px; }
.sp-dont-list { list-style: none; padding: 0; margin: 0; }
.sp-dont-list li { padding: 10px 0; font-size: 15px; line-height: 1.8; color: #4a1a1a; border-bottom: 1px solid #fecaca; }
.sp-dont-list li:last-child { border-bottom: none; }

.sp-legal-list { list-style: none; padding: 0; margin: 24px 0 0; }
.sp-legal-list li { padding: 14px 18px; background: #fff; border: 1px solid var(--c-border); border-radius: 10px; margin-bottom: 8px; font-size: 14px; line-height: 1.7; color: #333; }

.case-box { padding: 24px; background: #fff; border-radius: 14px; border: 1px solid var(--c-border); margin-top: 24px; }
.case-head { display: flex; align-items: center; gap: 14px; margin-bottom: 14px; }
.case-init { width: 42px; height: 42px; border-radius: 99px; background: #1a1a1a; color: #fff; display: flex; align-items: center; justify-content: center; font-weight: 600; font-family: Georgia, serif; }
.case-box p { font-size: 14.5px; line-height: 1.8; color: #333; margin: 0; padding: 6px 0; }

.sp-resource-card { display: block; padding: 28px; background: #fff; border: 1px solid var(--c-border); border-radius: 14px; margin-top: 24px; transition: all .15s; }
.sp-resource-card:hover { border-color: #000; box-shadow: 0 8px 24px rgba(0,0,0,.06); }

.final-cta { padding: 80px 0; }

@media (max-width: 768px) {
  .serv-hero-h1 { font-size: 36px; letter-spacing: -1px; }
  .sp-h2 { font-size: 24px; }
  .sp-scope-grid { grid-template-columns: 1fr; }
  .sp-do-list li { padding-left: 48px; }
}
</style>

