---
import Base from '../layouts/Base.astro';

import { OFFER_WALL } from '../data/site.js';
const TOTAL = OFFER_WALL.total;
const ALL_OFFERS = Array.from({ length: TOTAL }, (_, i) => {
  const num = String(i + 1).padStart(2, '0');
  return `/offers/offer-${num}.jpg`;
});
---
<Base title={`${TOTAL} 封录取通知书 · Maginex 录取墙`} description="过去 2 学年 Maginex 签约学生的真实录取通知书。Cornell / Berkeley / UCLA / NYU / CMU / USC 等 19 所学校。学生信息已脱敏，校徽印章保留。">
  <section class="offers-hero">
    <div class="container" style="max-width:880px">
      <div class="crumb"><a href="/">首页</a> / <span>录取通知书墙</span></div>
      <div class="eyebrow" style="margin-top:18px">RECEIPTS · 录取通知书墙</div>
      <h1 class="offers-h1">{TOTAL} 封 offer，<br/><span class="hl">每一封都签收过</span>。</h1>
      <p class="offers-lede">
        过去 2 学年（2024–2026）Maginex 签约学生收到的真实 admission letter 全集。
        <strong>学生姓名 / 申请号 / 个人信息已全部脱敏（黑色矩形遮挡）</strong>，校徽、印章、签发人姓名、签发日期保留——这些字段是<strong>真实可核</strong>的依据。
      </p>
      <div class="offers-stats">
        <div class="offers-stat">
          <div class="offers-stat-num">{TOTAL}</div>
          <div class="offers-stat-label">封 admission letter</div>
        </div>
        <div class="offers-stat">
          <div class="offers-stat-num">{OFFER_WALL.schools}</div>
          <div class="offers-stat-label">所学校覆盖</div>
        </div>
        <div class="offers-stat">
          <div class="offers-stat-num">2024–2026</div>
          <div class="offers-stat-label">签约届时间区间</div>
        </div>
      </div>
    </div>
  </section>

  <section class="offers-section">
    <div class="container">
      <div class="offers-grid">
        {ALL_OFFERS.map((src, idx) => (
          <button type="button" class="offers-card" data-offer-src={src} aria-label={`录取通知书 ${idx + 1}`}>
            <img src={src} alt={`录取通知书 ${idx + 1}（学生信息已脱敏）`} loading="lazy" />
            <div class="offers-card-num">#{String(idx + 1).padStart(2, '0')}</div>
          </button>
        ))}
      </div>
    </div>
  </section>

  <section class="offers-cta-section section-soft">
    <div class="container" style="max-width:720px;text-align:center">
      <div class="eyebrow">想成为 #44？</div>
      <h2 style="font-size:48px;font-weight:700;letter-spacing:-1.2px;line-height:1.1;margin-top:14px">把你的下一封 offer<br/><span class="hl">列入这面墙</span>。</h2>
      <p style="font-size:16px;color:#444;line-height:1.7;margin-top:20px">所有 offer 都来自我们的签约学生。所有签约学生都从一通 30 分钟免费评估开始。<strong>不录取退全款</strong>条款已过律所公证。</p>
      <div style="display:flex;gap:14px;margin-top:32px;justify-content:center;flex-wrap:wrap">
        <button type="button" data-wechat-cta="offers-final" class="btn btn-primary btn-lg">微信咨询 →</button>
        <a href="/contact/" class="btn btn-ghost btn-lg">免费 30 分钟评估</a>
      </div>
    </div>
  </section>

  <!-- Lightbox -->
  <div class="offer-lightbox" id="offer-lightbox" role="dialog" aria-modal="true" aria-hidden="true">
    <button type="button" class="offer-lightbox-close" aria-label="关闭">
      <svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M6 18L18 6" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
    <button type="button" class="offer-lightbox-nav offer-lightbox-prev" aria-label="上一张">‹</button>
    <button type="button" class="offer-lightbox-nav offer-lightbox-next" aria-label="下一张">›</button>
    <div class="offer-lightbox-content">
      <img id="offer-lightbox-img" src="" alt="" />
      <div class="offer-lightbox-counter" id="offer-lightbox-counter"></div>
    </div>
  </div>

  <script is:inline>
    (function () {
      const lightbox = document.getElementById('offer-lightbox');
      const lightboxImg = document.getElementById('offer-lightbox-img');
      const counter = document.getElementById('offer-lightbox-counter');
      const cards = Array.from(document.querySelectorAll('.offers-card'));
      let currentIdx = -1;

      function open(idx) {
        currentIdx = idx;
        const src = cards[idx].getAttribute('data-offer-src');
        lightboxImg.src = src;
        counter.textContent = `${idx + 1} / ${cards.length}`;
        lightbox.classList.add('open');
        lightbox.setAttribute('aria-hidden', 'false');
        document.body.style.overflow = 'hidden';
      }
      function close() {
        lightbox.classList.remove('open');
        lightbox.setAttribute('aria-hidden', 'true');
        document.body.style.overflow = '';
        currentIdx = -1;
      }
      function nav(dir) {
        if (currentIdx < 0) return;
        const next = (currentIdx + dir + cards.length) % cards.length;
        open(next);
      }

      cards.forEach((card, idx) => {
        card.addEventListener('click', () => open(idx));
      });
      lightbox.querySelector('.offer-lightbox-close').addEventListener('click', close);
      lightbox.querySelector('.offer-lightbox-prev').addEventListener('click', () => nav(-1));
      lightbox.querySelector('.offer-lightbox-next').addEventListener('click', () => nav(1));
      lightbox.addEventListener('click', (e) => { if (e.target === lightbox) close(); });
      document.addEventListener('keydown', (e) => {
        if (!lightbox.classList.contains('open')) return;
        if (e.key === 'Escape') close();
        if (e.key === 'ArrowLeft') nav(-1);
        if (e.key === 'ArrowRight') nav(1);
      });
    })();
  </script>
</Base>

<style is:global>
.offers-hero { padding: 64px 0 40px; background: linear-gradient(180deg, #fff, #fafafa); }
.crumb { font-size: 13px; color: #666; }
.crumb a { color: #666; }
.offers-h1 { font-size: 64px; font-weight: 700; letter-spacing: -2px; line-height: 1.05; margin-top: 18px; }
.offers-lede { font-size: 16px; color: #444; line-height: 1.7; margin-top: 22px; max-width: 720px; }
.offers-stats { display: flex; gap: 48px; margin-top: 36px; flex-wrap: wrap; padding-top: 32px; border-top: 1px solid var(--c-border); }
.offers-stat-num { font-size: 40px; font-weight: 700; letter-spacing: -1px; line-height: 1; }
.offers-stat-label { font-size: 12px; color: var(--c-muted); margin-top: 6px; letter-spacing: .5px; }

.offers-section { padding: 56px 0; }
.offers-grid {
  display: grid;
  grid-template-columns: repeat(6, 1fr);
  gap: 14px;
}
.offers-card {
  position: relative;
  aspect-ratio: 3 / 4;
  background: #f5f5f5;
  border: 1px solid var(--c-border);
  border-radius: 8px;
  overflow: hidden;
  cursor: pointer;
  padding: 0;
  font-family: inherit;
  transition: transform .2s, box-shadow .2s, border-color .2s;
}
.offers-card:hover {
  transform: translateY(-3px) scale(1.02);
  box-shadow: 0 12px 28px rgba(0,0,0,.1);
  border-color: #000;
}
.offers-card img {
  display: block;
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: top;
}
.offers-card-num {
  position: absolute;
  top: 6px;
  left: 6px;
  padding: 2px 8px;
  background: rgba(0,0,0,.7);
  color: #fff;
  font-size: 10px;
  font-weight: 600;
  letter-spacing: 1px;
  border-radius: 4px;
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
}

.offers-cta-section { padding: 80px 0; }

/* Lightbox */
.offer-lightbox {
  position: fixed;
  inset: 0;
  z-index: 9999;
  display: none;
  align-items: center;
  justify-content: center;
  background: rgba(0,0,0,.92);
  padding: 40px;
}
.offer-lightbox.open { display: flex; }
.offer-lightbox-content {
  position: relative;
  max-width: 90vw;
  max-height: 90vh;
  display: flex;
  align-items: center;
  justify-content: center;
}
.offer-lightbox-content img {
  max-width: 100%;
  max-height: 90vh;
  object-fit: contain;
  border-radius: 8px;
  box-shadow: 0 20px 60px rgba(0,0,0,.5);
}
.offer-lightbox-counter {
  position: absolute;
  bottom: -32px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 13px;
  color: rgba(255,255,255,.7);
  font-family: ui-monospace, SFMono-Regular, Menlo, monospace;
  letter-spacing: 1px;
  white-space: nowrap;
}
.offer-lightbox-close {
  position: absolute;
  top: 24px;
  right: 24px;
  width: 44px;
  height: 44px;
  border: none;
  background: rgba(255,255,255,.1);
  color: #fff;
  border-radius: 99px;
  cursor: pointer;
  display: flex;
  align-items: center;
  justify-content: center;
}
.offer-lightbox-close:hover { background: rgba(255,255,255,.2); }
.offer-lightbox-nav {
  position: absolute;
  top: 50%;
  transform: translateY(-50%);
  width: 56px;
  height: 56px;
  border: none;
  background: rgba(255,255,255,.1);
  color: #fff;
  border-radius: 99px;
  cursor: pointer;
  font-size: 32px;
  font-weight: 300;
  display: flex;
  align-items: center;
  justify-content: center;
}
.offer-lightbox-nav:hover { background: rgba(255,255,255,.2); }
.offer-lightbox-prev { left: 24px; }
.offer-lightbox-next { right: 24px; }

@media (max-width: 1024px) {
  .offers-grid { grid-template-columns: repeat(4, 1fr); }
  .offers-h1 { font-size: 44px; }
}
@media (max-width: 768px) {
  .offers-hero { padding: 48px 0 24px; }
  .offers-h1 { font-size: 32px; letter-spacing: -1px; }
  .offers-grid { grid-template-columns: repeat(3, 1fr); gap: 8px; }
  .offers-stats { gap: 24px; }
  .offers-stat-num { font-size: 28px; }
  .offer-lightbox { padding: 16px; }
  .offer-lightbox-nav { width: 44px; height: 44px; font-size: 28px; }
  .offer-lightbox-prev { left: 8px; }
  .offer-lightbox-next { right: 8px; }
  .offer-lightbox-close { top: 12px; right: 12px; }
}
</style>
