---
import { SITE, NAV } from '../data/site.js';
import '../styles/global.css';
import WeChatCTA from '../components/WeChatCTA.astro';
import StickyMobileBar from '../components/StickyMobileBar.astro';
import Analytics from '../components/Analytics.astro';

export interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  canonical?: string;
}

const {
  title = `${SITE.name} · ${SITE.tagline}`,
  description = SITE.description,
  ogImage = '/og-default.png',
  canonical,
} = Astro.props;

const canonicalURL = canonical || new URL(Astro.url.pathname, Astro.site).toString();
---
<!DOCTYPE html>
<html lang="zh-CN">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="generator" content={Astro.generator} />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="canonical" href={canonicalURL} />
  <meta property="og:title" content={title} />
  <meta property="og:description" content={description} />
  <meta property="og:type" content="website" />
  <meta property="og:url" content={canonicalURL} />
  <meta property="og:image" content={ogImage} />
  <meta name="twitter:card" content="summary_large_image" />
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
  {SITE.googleSiteVerification && <meta name="google-site-verification" content={SITE.googleSiteVerification} />}
  {SITE.bingSiteVerification && <meta name="msvalidate.01" content={SITE.bingSiteVerification} />}
  {SITE.baiduSiteVerification && <meta name="baidu-site-verification" content={SITE.baiduSiteVerification} />}
  {SITE.yandexSiteVerification && <meta name="yandex-verification" content={SITE.yandexSiteVerification} />}
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet" />
  <Analytics />
  <slot name="head" />
</head>
<body>

<!-- Top notification bar -->
<div class="topbar topbar-emergency">
  <span><span class="dot dot-urgent"></span>紧急情况 · 凌晨 / 周末同样响应 · <strong style="color:#000">真人 24h 内回复</strong></span>
  <button type="button" data-wechat-cta="topbar-emergency" class="topbar-cta">立即微信急救 →</button>
</div>

<!-- Header -->
<header class="header">
  <div class="header-inner">
    <a href="/" class="brand" aria-label="Maginex 首页">
      <span class="logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M3 21V3L12 11L21 3V21" stroke="#000" stroke-width="2.5" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="brand-name">maginex</span>
    </a>
    <nav class="nav">
      {NAV.map(item => <a href={item.href}>{item.label}</a>)}
    </nav>
    <div class="header-cta">
      <span class="lang">EN</span>
      <button type="button" class="btn btn-primary" data-wechat-cta="header">微信咨询</button>
      <button class="menu-toggle" aria-label="菜单" id="menu-open">
        <svg viewBox="0 0 24 24" fill="none"><path d="M4 6h16M4 12h16M4 18h16" stroke="#000" stroke-width="2" stroke-linecap="round"/></svg>
      </button>
    </div>
  </div>
</header>

<!-- Mobile menu -->
<div class="mobile-menu" id="mobile-menu">
  <div class="mobile-menu-head">
    <a href="/" class="brand">
      <span class="logo">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none">
          <path d="M3 21V3L12 11L21 3V21" stroke="#000" stroke-width="2.5" stroke-linejoin="round"/>
        </svg>
      </span>
      <span class="brand-name">maginex</span>
    </a>
    <button class="menu-toggle" aria-label="关闭" id="menu-close">
      <svg viewBox="0 0 24 24" fill="none"><path d="M6 6l12 12M6 18L18 6" stroke="#000" stroke-width="2" stroke-linecap="round"/></svg>
    </button>
  </div>
  <nav>
    {NAV.map(item => <a href={item.href}>{item.label}</a>)}
    <button type="button" data-wechat-cta="mobile-menu" style="margin-top:24px" class="btn btn-primary btn-lg">微信直聊顾问 →</button>
    <a href="/contact/" style="margin-top:10px" class="btn btn-ghost">填表预约</a>
  </nav>
</div>

<main>
  <slot />
</main>

<!-- Footer — emergency-first IA, brand-centered with flanking QRs -->
<footer class="footer footer-v2">
  <div class="container">

    <!-- Hidden services columns（保留可访问性 SEO，视觉折叠到下方 nav）-->
    <details class="footer-services">
      <summary>查看完整服务列表</summary>
      <div class="footer-services-grid">
        <div>
          <div class="footer-head">🚨 急救服务</div>
          <a href="/services/#sevis-i20" class="footer-link">SEVIS / I-20 急救</a>
          <a href="/services/academic-appeal/" class="footer-link">学术 dismissal 申诉</a>
          <a href="/services/#rfe-response" class="footer-link">RFE 应对</a>
          <a href="/services/urgent-transfer/" class="footer-link">紧急转学</a>
          <a href="/services/b-to-f/" class="footer-link">B 转 F 身份</a>
        </div>
        <div>
          <div class="footer-head">📋 规划服务</div>
          <a href="/services/cc-to-uc/" class="footer-link">CC 转 UC 名校直通车 ★</a>
          <a href="/services/#opt-stem" class="footer-link">OPT STEM 延期</a>
          <a href="/services/#undergrad" class="footer-link">美本申请</a>
          <a href="/services/#master" class="footer-link">美硕申请</a>
        </div>
      </div>
    </details>

    <!-- Top: brand center, QRs flanking -->
    <div class="footer-top">
      <div class="footer-qr-stack footer-qr-left">
        <a href="/contact/" class="footer-qr-card" aria-label="微信咨询二维码">
          <img src={SITE.qrFiles.wechat} alt="Maginex 向导 微信咨询二维码" loading="lazy" />
          <span class="footer-qr-caption">扫码 · 微信咨询</span>
        </a>
      </div>

      <div class="footer-brand-center">
        <div class="footer-brand-row">
          <span class="logo logo-dark" aria-hidden="true">
            <svg width="28" height="28" viewBox="0 0 24 24" fill="none">
              <path d="M3 21V3L12 11L21 3V21" stroke="#fff" stroke-width="2.5" stroke-linejoin="round"/>
            </svg>
          </span>
          <span class="footer-brand-name">Maginex</span>
          <span class="footer-brand-en">EDUCATION</span>
        </div>
        <p class="footer-tagline">{SITE.sloganLong}</p>
        <p class="footer-mini">实战 8 年 · 400+ 急救 case · 公对公转账 · 不录取退全款 · 案件失败退服务费</p>

        <nav class="footer-nav-row" aria-label="footer nav">
          <a href="/services/">服务项目</a>
          <a href="/consultants/">团队结构</a>
          <a href="/cases/">学生案例</a>
          <a href="/resources/">资源中心</a>
          <a href="/#emergency">急救场景</a>
          <a href="/contact/">联系咨询</a>
        </nav>

        <div class="footer-contact-row">
          <div class="footer-contact-item">
            <span class="footer-contact-k">电话</span>
            <span class="footer-contact-v">🇺🇸 {SITE.phones.us[0]} <span class="dim">/</span> 🇨🇳 {SITE.phones.cn[0]}</span>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-k">邮箱</span>
            <a href={`mailto:${SITE.email}`} class="footer-contact-v">{SITE.email}</a>
          </div>
          <div class="footer-contact-item">
            <span class="footer-contact-k">办公地</span>
            <span class="footer-contact-v">{SITE.offices.us} · {SITE.offices.cn}</span>
          </div>
        </div>
      </div>

      <div class="footer-qr-stack footer-qr-right">
        {SITE.qrFiles.publicAccount && (
          <a href="#" class="footer-qr-card" aria-label="公众号二维码">
            <img src={SITE.qrFiles.publicAccount} alt="Maginex 公众号二维码" loading="lazy"
                 onerror="this.parentElement.style.display='none'" />
            <span class="footer-qr-caption">关注 · 公众号</span>
          </a>
        )}
        {SITE.qrFiles.xiaohongshu && (
          <a href="#" class="footer-qr-card" aria-label="小红书二维码">
            <img src={SITE.qrFiles.xiaohongshu} alt="Maginex 小红书二维码" loading="lazy"
                 onerror="this.parentElement.style.display='none'" />
            <span class="footer-qr-caption">小红书</span>
          </a>
        )}
      </div>
    </div>

    <!-- Bottom: copyright + (conditional) filings + tiny links -->
    <div class="footer-bottom">
      <div class="footer-copyright">
        <span>© 2019–2026 Maginex Education · 版权所有</span>
        {SITE.icpFiling && <span class="footer-filing"> · {SITE.icpFiling}</span>}
        {SITE.psbFiling && (
          <span class="footer-filing footer-psb">
            <span class="psb-dot" aria-hidden="true">●</span>
            {SITE.psbFiling}
          </span>
        )}
      </div>
      <div class="footer-bottom-links">
        <a href="/contact/">隐私政策</a>
        <a href="/contact/">服务条款</a>
        <a href="/contact/">退款政策</a>
      </div>
    </div>

  </div>

  <!-- Floating right-bottom CTA pills（覆盖 sticky mobile bar 之上） -->
  <div class="footer-floating-ctas" aria-label="快速咨询">
    <a href="/contact/" class="float-cta float-cta-blue">
      <span class="float-cta-icon">💬</span>
      <span>免费在线咨询</span>
    </a>
    <button type="button" data-wechat-cta="footer-floating" class="float-cta float-cta-green">
      <span class="float-cta-icon">●</span>
      <span>免费微信咨询</span>
    </button>
  </div>
  </div>
</footer>

<WeChatCTA />
<StickyMobileBar />

<script>
  const menu = document.getElementById('mobile-menu');
  document.getElementById('menu-open')?.addEventListener('click', () => menu?.classList.add('open'));
  document.getElementById('menu-close')?.addEventListener('click', () => menu?.classList.remove('open'));
</script>

</body>
</html>
